{
  "compilerOptions": {
    "target": "es2024",
    "module": "commonjs",
    "lib": ["es2024"],
    "sourceMap": true,
    "outDir": "./target",
    "rootDir": "./source",
    "noEmitOnError": true,
    "strict": true,
    "types": ["node", "jest"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": [
    "docs",
    "scripts",
    "node_modules",
    "target",
    "tests",
    "./ecosystem.config.js",
    "./jest.config.js",
    "./jest.setup.js",
    "eslint.config.mjs"
  ]
}
